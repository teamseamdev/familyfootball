{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,config/default.json}",
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
